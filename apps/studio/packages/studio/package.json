{
  "name": "studio",
  "version": "1.0.0",
  "description": "ArgantaStudio surface components + provider fabric",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
