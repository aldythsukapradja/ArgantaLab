{
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build && cd .. && node scripts/build-deploy.mjs",
  "outputDirectory": "dist_site",
  "redirects": [
    { "source": "/", "destination": "/command/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/lab/((?!data/|assets/|sw.js|manifest.webmanifest|icon-).*)", "destination": "/lab/index.html" }
  ],
  "headers": [
    { "source": "/lab/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
