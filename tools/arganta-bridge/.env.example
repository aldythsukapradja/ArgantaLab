# Copy to .env (gitignored). HQ must send the same BRIDGE_TOKEN.
BRIDGE_TOKEN=change-me-to-a-long-random-string
BRIDGE_PORT=7717
# Optional: pin a model for bridge-run missions (default = Claude Code default).
# BRIDGE_MODEL=claude-opus-4-8
# Optional: this machine's Tailscale IP (100.x.x.x), so a phone/laptop on your
# private tailnet can reach the bridge remotely. Leave unset for localhost-only.
# BRIDGE_TAILSCALE_IP=100.x.x.x
# Claude Code auth: uses your existing CLI login / ANTHROPIC_API_KEY from the env.

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
