# Copy to .env (gitignored) and fill in real values.

# Same Cloudflare Worker HQ already uses for image gen — reuse the values from
# tools/arganta-core-mcp/.env (they point at the same deployed Worker).
ARGANTA_CORE_URL=
ARGANTA_CORE_TOKEN=

# Leonardo.ai — dashboard.leonardo.ai → API Access → generate a key. Free plan
# gives ~150 tokens/day that reset daily.
LEONARDO_API_KEY=

# --- Provider order (optional) --------------------------------------------
# Comma list, tried left-to-right with fallback. Unknown names are ignored.
# Leave unset to keep the original default (cloudflare,leonardo). To prefer your
# own GPU first: local,modal,cloudflare,leonardo
MEDIA_PROVIDER_ORDER=

# --- Local ComfyUI (only used if listed in MEDIA_PROVIDER_ORDER) -----------
# Start it with start-comfyui.bat. Default URL is fine unless you changed the port.
COMFY_URL=http://127.0.0.1:8188
COMFY_CKPT=v1-5-pruned-emaonly.safetensors

# --- Modal FLUX via your deployed media-proxy Edge Function ----------------
# MEDIA_PROXY_URL = https://<project-ref>.supabase.co/functions/v1/media-proxy
# SUPABASE_ANON_KEY = project anon key (public; used as the Bearer for the fn)
MEDIA_PROXY_URL=
SUPABASE_ANON_KEY=

# --- Persistence (optional): bytes→bucket + lineage ------------------------
# With both set, every generated image also uploads to the media-artifacts
# storage bucket and gets a media_asset lineage row (schema:
# supabase/migration_media_assets.sql). Service key = Supabase dashboard →
# Settings → API → service_role (same as tools/arganta-core-mcp/.env).
# Leave blank for local-file-only behaviour.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
