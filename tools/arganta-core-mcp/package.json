{
  "name": "arganta-core-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP bridge: describe a post in Claude Code → Arganta Core (Cloudflare Worker) generates copy + images → a draft lands in HQ's Content Builder Drafts inbox.",
  "bin": { "arganta-core-mcp": "src/server.ts" },
  "scripts": {
    "dev": "tsx src/server.ts",
    "stdio": "tsx src/server.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector tsx src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
